# Copy this file to config.env and fill in real values.
# config.env is read by deploy.sh — never commit it (it holds secrets).

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=default          # the AWS CLI profile to use (aws configure --profile ...)

# --- Naming (safe to leave as-is for the demo) ---
FUNCTION_NAME=lakeamerica-chat-backend
ROLE_NAME=lakeamerica-chat-lambda-role
TABLE_NAME=chatbot-conversations
API_NAME=lakeamerica-chat-api

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- S3 (new-patient intake Excel workbook) ---
# Bucket names must be globally unique across ALL of AWS, not just your
# account. Pick something specific, e.g. lakeamerica-intake-fahad-2026.
S3_BUCKET=CHANGE-ME-globally-unique-bucket-name
S3_KEY=new-patient-intake.xlsx

# --- CORS ---
# The exact origin your widget will be embedded on. Use "*" only while
# testing locally — lock this down before handing anything to a real client.
ALLOWED_ORIGIN=*
